rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo la cuenta compartida de la mesa (creada en Authentication) puede escribir.
    function isStaff() {
      return request.auth != null
        && request.auth.token.email == 'mesa@torneo.hoopz';
    }

    // Cualquier persona puede leer; solo el staff escribe.
    match /config/{id} { allow read: if true; allow write: if isStaff(); }
    match /teams/{id}  { allow read: if true; allow write: if isStaff(); }
    match /games/{id}  { allow read: if true; allow write: if isStaff(); }
    match /draft/{id}  { allow read: if true; allow write: if isStaff(); }

    // Aviso de resultados: la mesa lo actualiza al finalizar/cambiar un partido; las páginas sin tiempo real lo escuchan.
    match /meta/{id}   { allow read: if true; allow write: if isStaff(); }

    // Monitoreo: cualquier dispositivo reporta su latido (solo esos campos, tamaño acotado); solo el staff lee.
    match /presence/{id} {
      allow read: if isStaff();
      allow create, update: if request.resource.data.keys().hasOnly(['t', 'day', 'page', 'reads', 'writes'])
        && request.resource.data.t is number && request.resource.data.reads is number
        && request.resource.data.writes is number && request.resource.data.day is string
        && request.resource.data.day.size() <= 10 && request.resource.data.page is string
        && request.resource.data.page.size() <= 30;
    }

    // Todo lo demás queda denegado.
  }
}
